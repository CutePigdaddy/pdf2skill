{
  "name": "@pdf2skill/sdk",
  "version": "0.1.0",
  "description": "Browser SDK for pdf2skill: converts PDF textbooks into Claude Agent Skill packages, running fully client-side.",
  "type": "module",
  "main": "./dist/pdf2skill.cjs",
  "module": "./dist/pdf2skill.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pdf2skill.js",
      "require": "./dist/pdf2skill.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sync-prompts": "node scripts/sync-prompts.mjs",
    "predev": "npm run sync-prompts",
    "dev": "vite build --watch",
    "prebuild": "npm run sync-prompts",
    "build": "vite build",
    "test": "vitest run",
    "pretest": "npm run sync-prompts"
  },
  "peerDependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0"
  }
}

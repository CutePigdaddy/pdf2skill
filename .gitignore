# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ── Virtual environments ───────────────────────────────────────────
.venv/
venv/
env/

# ── Environment & secrets ─────────────────────────────────────────
.env
.env.*

# ── Runtime outputs ───────────────────────────────────────────────
logs/
outputs/
inputs/
scan-output/
test_outputs/
tests/logs/

# ── OS files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Generated document folders (user-specific) ────────────────────
CS/
vjf/
vj/
DLCO/
condensed-matter-physics/
EY/

# ── Docs with large binaries ──────────────────────────────────────
docs/samples/

# ── Ad-hoc scripts (not part of core project) ─────────────────────
scripts/

# ── Misc generated files ──────────────────────────────────────────
*.pdf
repo-scan-data.md
repo-scan-report.md
report.html
vjf.md
status.txt
still_tracked.txt
tracked_files.txt

# ── Reference docs (external, not project source) ─────────────────
docs/api/

# ── Frontend runtime artifacts ────────────────────────────────────
frontend/screenshot_*.png

# ── Node / TypeScript ──────────────────────────────────────────────
node_modules/
*.tsbuildinfo
# dist/ already ignored above (Python build) and also covers packages/*/dist

# scripts/ rule above is for ad-hoc Python scripts; keep SDK build scripts tracked
!packages/sdk/scripts/
# SDK prompt copies are generated from root prompts/ by sync-prompts.mjs
packages/sdk/src/prompts/

# ── Python↔TS alignment scratch outputs (regenerable fixtures) ─────
.m4align/py_out/
.m4align/ts_out/
.m4align/*_prompts.json

# ── Claude Code session files ─────────────────────────────────────
.claude/
